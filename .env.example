# true = built-in sample data (default). Set to false to call the Frappe API scripts.
VITE_USE_MOCK=false
# City tiers from a Google Sheet (optional). Publish the sheet to the web as CSV and paste the link here.
# Without it the built-in list in src/tiers.js is used. Needs a redeploy after changing.
VITE_TIERS_SHEET_CSV_URL=
